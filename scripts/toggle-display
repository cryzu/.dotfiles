#!/bin/bash
# toggle-laptop-display.sh — toggles laptop screen and adjusts focus/layout

LAPTOP="eDP-1"
EXTERNAL="HDMI-A-1"

if hyprctl monitors | grep -q "$LAPTOP"; then
    # Laptop screen is ON → disable it and make HDMI main
    hyprctl keyword monitor "$LAPTOP,disable"
    sleep 0.3
    hyprctl dispatch focusmonitor "$EXTERNAL"
else
    # Laptop screen is OFF → re-enable it on the left and make it main again
    hyprctl keyword monitor "$LAPTOP,1920x1080@120.21,0x0,1"
    sleep 0.5
    hyprctl dispatch focusmonitor "$LAPTOP"
    hyprctl dispatch moveworkspacetomonitor 1 "$LAPTOP"
fi
