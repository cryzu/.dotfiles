#!/bin/bash
# Toggles the laptop screen and adjusts focus/layout

LAPTOP="eDP-1"
EXTERNAL="HDMI-A-1"

if hyprctl monitors -j | jq -e --arg m "$LAPTOP" 'any(.[]; .name == $m)' >/dev/null; then
    # Laptop screen is ON → disable it and make HDMI main
    hyprctl eval "hl.monitor({ output = '$LAPTOP', disabled = true })"
    sleep 0.3
    hyprctl dispatch "hl.dsp.focus({ monitor = '$EXTERNAL' })"
else
    # Laptop screen is OFF → re-enable it on the left and make it main again
    hyprctl eval "hl.monitor({ output = '$LAPTOP', disabled = false, mode = '1920x1080@120.21', position = '0x0', scale = 1 })"
    sleep 0.5
    hyprctl dispatch "hl.dsp.focus({ monitor = '$LAPTOP' })"
    hyprctl dispatch "hl.dsp.workspace.move({ workspace = 1, monitor = '$LAPTOP' })"
fi
